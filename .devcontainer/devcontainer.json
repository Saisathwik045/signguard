{
  "name": "SignGuard private staging preparation",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [],
  "portsAttributes": {
    "8501": {"label": "SignGuard — keep PRIVATE", "onAutoForward": "ignore"},
    "8080": {"onAutoForward": "ignore"}
  },
  "postCreateCommand": "python -m pip install 'pip>=26.2,<27' && python -m pip install -c requirements-cloud.txt -e '.[dev]'",
  "remoteUser": "vscode"
}
