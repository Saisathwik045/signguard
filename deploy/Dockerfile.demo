# syntax=docker/dockerfile:1
FROM scratch AS catalogue
COPY src/signguard/demo.py /bundle/signguard/
COPY src/signguard/demo_assets /bundle/signguard/demo_assets/
COPY synthetic_demo.py /bundle/

FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
WORKDIR /opt/signguard
COPY requirements-cloud.txt ./
# Copy the small catalogue before dependencies to avoid duplicating large VFS layers.
COPY --from=catalogue --chown=65532:65532 /bundle/ ./
RUN --mount=type=secret,id=proxy_ca \
    set -e; apt-get update; apt-get -y upgrade; \
    apt-get install -y --no-install-recommends python3 python3-venv ca-certificates; \
    python3 -m venv /opt/venv; \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    /opt/venv/bin/pip install --no-cache-dir 'pip>=26.2,<27'; \
    /opt/venv/bin/pip install --no-cache-dir -c requirements-cloud.txt 'streamlit>=1.45,<2'; \
    /opt/venv/bin/python -m pip uninstall -y pip; \
    apt-get purge -y python3-venv python3.14-venv python3-pip-whl; apt-get autoremove -y; rm -rf /var/lib/apt/lists/*
# No PDF/image analysis libraries, broker client, executor, credentials or Docker socket.
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
USER 65532:65532
ENTRYPOINT ["streamlit", "run", "synthetic_demo.py", "--server.address=0.0.0.0", "--server.maxUploadSize=1", "--server.maxMessageSize=5", "--browser.gatherUsageStats=false"]
