# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
WORKDIR /opt/signguard
COPY pyproject.toml requirements-cloud.txt ./
COPY src ./src
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir 'pip>=26.2,<27' && pip install --no-cache-dir -c requirements-cloud.txt . && groupadd --gid 65532 signguard && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /nonexistent signguard
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["python", "-I", "-m", "signguard.worker"]
