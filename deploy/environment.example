# Configure only in a trusted cloud host/secret manager. Never commit populated values.
SIGNGUARD_BROKER_TOKEN=
SIGNGUARD_ALLOWED_EMAILS=
SIGNGUARD_OIDC_SECRETS=/secure/path/secrets.toml
SIGNGUARD_EXECUTOR_GID=
SIGNGUARD_EXECUTOR_DIRECTORY=
SIGNGUARD_AUDIT_DIRECTORY=
SIGNGUARD_WORKER_IMAGE=signguard-worker:phase4
