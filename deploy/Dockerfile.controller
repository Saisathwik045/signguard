FROM python:3.12-slim-bookworm
WORKDIR /opt/signguard
COPY --chown=65532:65532 src/signguard ./signguard
RUN python -m pip uninstall -y pip
USER 65532:65532
ENV SIGNGUARD_BROKER_HOST=0.0.0.0 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2)"
ENTRYPOINT ["python", "-m", "signguard.broker"]
