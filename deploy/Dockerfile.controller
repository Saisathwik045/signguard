FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
WORKDIR /opt/signguard
COPY --chown=65532:65532 src/signguard/*.py ./signguard/
RUN apt-get update && apt-get -y upgrade && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
USER 65532:65532
ENV SIGNGUARD_BROKER_HOST=0.0.0.0 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=3s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2)"
ENTRYPOINT ["python3", "-m", "signguard.broker"]
