[Unit]
Description=Anchor SignGuard audit snapshots to locked S3 storage
RequiresMountsFor=/var/lib/signguard/audit
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/signguard/current
EnvironmentFile=/etc/signguard/anchor.env
ExecStart=/opt/signguard/executor-venv/bin/python scripts/anchor_audit.py /var/lib/signguard/audit/audit.jsonl ${SIGNGUARD_AUDIT_BUCKET} --cursor /var/lib/signguard-edge/anchor-head
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signguard-edge
ProtectHome=true
PrivateTmp=true
